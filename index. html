                <p id="printSubTitle">كشف قراءات المياه</p>
                <hr style="margin: 10px 0; border: 1px solid #cbd5e1;">
            </div>

            <!-- جدول صفحة القراءات -->
            <div class="table-responsive" id="readingsTableContainer">
                <table id="dataTableReadings">
                    <thead>
                        <tr>
                            <th style="width: 50px;">م</th>
                            <th style="width: 90px;">رقم المشترك</th>
                            <th style="text-align: right; padding-right: 15px;">اسم المشترك</th>
