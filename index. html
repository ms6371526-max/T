                        <option value="منفعة عامة / وقف" ${sub.type === 'منفعة عامة / وقف' ? 'selected' : ''}>وقف / منفعة</option>
                        <option value="تحت الإنشاء" ${sub.type === 'تحت الإنشاء' ? 'selected' : ''}>تحت الإنشاء</option>
