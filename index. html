    function getStorageKey(month, year) {
        return month + "_" + year;
    }

    function getPreviousMonthAndYear(month, year) {
        const months = ["يناير", "فبراير", "مارس", "إبريل", "مايو", "يونيو", "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر"];
        let idx = months.indexOf(month);
        let prevMonth = "";
        let prevYear = parseInt(year);

        if (idx === 0) {
            prevMonth = "ديسمبر";
            prevYear -= 1;
        } else {
            prevMonth = months[idx - 1];
        }
        return { month: prevMonth, year: prevYear };
    }

    function copyPreviousMonthReadings() {
        const curMonth = document.getElementById('monthSelect').value;
        const curYear = document.getElementById('yearSelect').value;
        const village = document.getElementById('villageSelect').value;

        const prevInfo = getPreviousMonthAndYear(curMonth, curYear);
        const prevKey = getStorageKey(prevInfo.month, prevInfo.year);
        const curKey = getStorageKey(curMonth, curYear);

        if (!dbReadings[prevKey]) {
            alert(`عفواً، لا توجد قراءات مسجلة للشهر السابق (${prevInfo.month} ${prevInfo.year}) لترحيلها.`);
            return;
        }

        if (!dbReadings[curKey]) {
            dbReadings[curKey] = {};
        }

        const filteredSubs = subscribers.filter(s => s.village === village);
        let count = 0;

        filteredSubs.forEach(sub => {
            const prevData = dbReadings[prevKey][sub.id];
            if (prevData) {
                if (!dbReadings[curKey][sub.id]) {
                    dbReadings[curKey][sub.id] = { prev: 0, curr: 0, arrears: 0, collected: 0, note: "" };
                }
                // نسخ القراءة الحالية للشهر السابق لتصبح القراءة السابقة
                dbReadings[curKey][sub.id].prev = prevData.curr;
                if (!dbReadings[curKey][sub.id].curr || dbReadings[curKey][sub.id].curr < prevData.curr) {
                    dbReadings[curKey][sub.id].curr = prevData.curr;
                }
                // حساب المتبقي من الشهر السابق وترحيله كمتأخرات (المتأخرات السابقة + الإجمالي - المحصل)
                const prevDiff = Math.max(0, prevData.curr - prevData.prev);
                let prevFixed = (sub.type === "منفعة عامة / وقف") ? 0 : 400;
                let prevPrice = (sub.type === "تحت الإنشاء") ? 700 : 300;
                let prevTotal = (prevDiff * prevPrice) + prevFixed + (prevData.arrears || 0);
                let prevRemaining = prevTotal - (prevData.collected || 0);

                dbReadings[curKey][sub.id].arrears = Math.max(0, prevRemaining);
                count++;
            }
        });

        localStorage.setItem('water_db_readings', JSON.stringify(dbReadings));
        renderActiveTab();
        alert(`تم ترحيل قراءات ومتأخرات ${count} مشترك بنجاح من شهر ${prevInfo.month} إلى ${curMonth} ${curYear}!`);
    }

    function calculateTotal(diff, type, arrears) {
        if (type === "منفعة عامة / وقف") {
            return (diff * 300) + arrears;
        } else if (type === "تحت الإنشاء") {
            return (diff * 700) + 400 + arrears;
        } else {
            return (diff * 300) + 400 + arrears; // سكني
        }
    }

    function renderReadingsTable() {
        const village = document.getElementById('villageSelect').value;
        const month = document.getElementById('monthSelect').value;
        const year = document.getElementById('yearSelect').value;
        const key = getStorageKey(month, year);

        if (!dbReadings[key]) dbReadings[key] = {};

        const tbody = document.getElementById('tableBodyReadings');
        tbody.innerHTML = '';

        const filteredSubs = subscribers.filter(s => s.village === village);

        let totDiff = 0;
        let totArrears = 0;
        let totGrand = 0;

        filteredSubs.forEach((sub, index) => {
            if (!dbReadings[key][sub.id]) {
                dbReadings[key][sub.id] = { prev: 0, curr: 0, arrears: 0, collected: 0, note: "" };
            }
            const rData = dbReadings[key][sub.id];
            const diff = Math.max(0, rData.curr - rData.prev);
            const total = calculateTotal(diff, sub.type, rData.arrears);

            totDiff += diff;
            totArrears += rData.arrears;
            totGrand += total;

            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td>${index + 1}</td>
                <td>${sub.id}</td>
