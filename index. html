                <button class="btn btn-logout" onclick="handleLogout()">تسجيل خروج</button>
            </div>
        </div>

        <!-- التبويبات (الصفحات) -->
        <div class="nav-tabs">
            <button class="tab-btn active" id="tabReadings" onclick="switchTab('readings')">📁 صفحة القراءات</button>
            <button class="tab-btn" id="tabCollection" onclick="switchTab('collection')">💰 صفحة التحصيل</button>
        </div>

        <div class="filter-section">
            <div class="filter-group">
                <select id="yearSelect" onchange="renderActiveTab()">
                    <option value="2026" selected>2026</option>
                    <option value="2025">2025</option>
                    <option value="2024">2024</option>
                </select>
                <label>السنة</label>
            </div>
            <div class="filter-group">
                <select id="villageSelect" onchange="renderActiveTab()">
                    <option value="المقالح" selected>المقالح</option>
                    <option value="بيت الدكيني السفلى">بيت الدكيني السفلى</option>
                    <option value="بيت الدكيني العليا">بيت الدكيني العليا</option>
                    <option value="بيت الماس العليا">بيت الماس العليا</option>
                    <option value="بيت الماس السفلى">بيت الماس السفلى</option>
                    <option value="نمران">نمران</option>
                    <option value="الجلوب">الجلوب</option>
                    <option value="نمران العفه">نمران العفه</option>
                    <option value="المذل">المذل</option>
                    <option value="بيت البداء">بيت البداء</option>
                </select>
                <label>القرية</label>
            </div>
            <div class="filter-group">
                <select id="monthSelect" onchange="renderActiveTab()">
                    <option value="يناير">يناير</option>
                    <option value="فبراير">فبراير</option>
                    <option value="مارس">مارس</option>
                    <option value="إبريل">إبريل</option>
                    <option value="مايو">مايو</option>
                    <option value="يونيو">يونيو</option>
                    <option value="يوليو">يوليو</option>
                    <option value="أغسطس">أغسطس</option>
                    <option value="سبتمبر">سبتمبر</option>
                    <option value="أكتوبر" selected>أكتوبر</option>
                    <option value="نوفمبر">نوفمبر</option>
                    <option value="ديسمبر">ديسمبر</option>
                </select>
                <label>شهر الاستهلاك</label>
            </div>
        </div>

        <!-- أزرار الإجراءات الخاصة بصفحة القراءات -->
        <div class="action-bar" id="readingsActionBar">
            <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                <button class="btn btn-success" onclick="openAddModal()">➕ إضافة مشترك جديد</button>
                <button class="btn btn-amber" onclick="copyPreviousMonthReadings()" title="ترحيل القراءات الحالية والمتأخرات المتبقية من الشهر السابق">⚡ ترحيل قراءات الشهر السابق</button>
                <button class="btn btn-pdf" onclick="generatePDF()">📄 تصدير PDF</button>
                <button class="btn btn-excel" onclick="exportExcel('readings')">📊 تصدير إكسل</button>
            </div>
            <div style="font-size: 0.85rem; color: #475569;">
                تعرفة: 300 (أو 700 للإنشاء) | ثابت: 400 (يستثنى الوقف)
            </div>
        </div>

        <!-- أزرار الإجراءات الخاصة بصفحة التحصيل -->
        <div class="action-bar" id="collectionActionBar" style="display: none;">
            <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                <button class="btn btn-pdf" onclick="generatePDF()">📄 تصدير تحصيل PDF</button>
                <button class="btn btn-excel" onclick="exportExcel('collection')">📊 تصدير تحصيل إكسل</button>
            </div>
            <div style="font-size: 0.85rem; color: #475569;">
                سجل التحصيل والمبالغ المحصلة والمتبقي
            </div>
        </div>

        <div id="printArea">
