                            <td id="totArrears">0</td>
                            <td id="totGrand">0</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- جدول صفحة التحصيل -->
            <div class="table-responsive" id="collectionTableContainer" style="display: none;">
                <table id="dataTableCollection">
                    <thead>
                        <tr>
                            <th style="width: 85px;">رقم الفاتوره</th>
                            <th style="width: 95px;">رقم المشترك</th>
                            <th style="text-align: right; padding-right: 15px;">اســــــــــــــــــــم المشترك</th>
