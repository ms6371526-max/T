                    <option value="المقالح">المقالح</option>
                    <option value="بيت الدكيني السفلى">بيت الدكيني السفلى</option>
                    <option value="بيت الدكيني العليا">بيت الدكيني العليا</option>
                    <option value="بيت الماس العليا">بيت الماس العليا</option>
                    <option value="بيت الماس السفلى">بيت الماس السفلى</option>
                    <option value="نمران">نمران</option>
                    <option value="الجلوب">الجلوب</option>
                    <option value="نمران العفه">نمران العفه</option>
                    <option value="المذل">المذل</option>
                    <option value="بيت البداء">بيت البداء</option>
                </select>
            </div>
            <div class="form-row">
                <label>نوع المشترك:</label>
                <select id="newType">
                    <option value="سكني">سكني</option>
                    <option value="منفعة عامة / وقف">منفعة عامة / وقف</option>
                    <option value="تحت الإنشاء">تحت الإنشاء</option>
                </select>
            </div>
            <div class="modal-footer">
                <button class="btn" style="background-color: #64748b;" onclick="closeAddModal()">إلغاء</button>
                <button class="btn btn-success" onclick="saveNewSubscriber()">حفظ</button>
            </div>
        </div>
    </div>

