                <td style="text-align: right; padding-right: 15px; font-weight: 500;">${sub.name}</td>
                <td><strong style="color: #1e40af;">${total.toLocaleString()}</strong></td>
                <td><input type="number" class="cell-input" value="${collected}" onchange="updateCollectionData('${sub.id}', 'collected', this.value)"></td>
                <td><strong style="color: ${remaining > 0 ? '#dc2626' : '#16a34a'};">${remaining.toLocaleString()}</strong></td>
                <td><input type="text" class="cell-input" value="${rData.note || ''}" onchange="updateCollectionData('${sub.id}', 'note', this.value)" style="background:#fff;"></td>
            `;
            tbody.appendChild(tr);
        });

        document.getElementById('colTotGrand').innerText = totGrand.toLocaleString();
        document.getElementById('colTotCollected').innerText = totCollected.toLocaleString();
        document.getElementById('colTotRemaining').innerText = totRemaining.toLocaleString();
    }

    function updateReadingData(id, field, val) {
        const month = document.getElementById('monthSelect').value;
        const year = document.getElementById('yearSelect').value;
        const key = getStorageKey(month, year);

        if (!dbReadings[key][id]) dbReadings[key][id] = { prev: 0, curr: 0, arrears: 0, collected: 0, note: "" };
        dbReadings[key][id][field] = (field === 'note') ? val : (parseInt(val) || 0);

        localStorage.setItem('water_db_readings', JSON.stringify(dbReadings));
        renderActiveTab();
    }

    function updateCollectionData(id, field, val) {
        const month = document.getElementById('monthSelect').value;
        const year = document.getElementById('yearSelect').value;
        const key = getStorageKey(month, year);

        if (!dbReadings[key][id]) dbReadings[key][id] = { prev: 0, curr: 0, arrears: 0, collected: 0, note: "" };
        dbReadings[key][id][field] = (field === 'note') ? val : (parseInt(val) || 0);

        localStorage.setItem('water_db_readings', JSON.stringify(dbReadings));
        renderCollectionTable();
    }

    function updateSubType(id, val) {
        const sub = subscribers.find(s => s.id === id);
        if (sub) {
            sub.type = val;
            localStorage.setItem('water_subscribers', JSON.stringify(subscribers));
            renderActiveTab();
        }
    }

    function openAddModal() {
        document.getElementById('addModal').style.display = 'flex';
        document.getElementById('newVillage').value = document.getElementById('villageSelect').value;
    }

    function closeAddModal() {
        document.getElementById('addModal').style.display = 'none';
    }

    function saveNewSubscriber() {
        const id = document.getElementById('newId').value;
        const name = document.getElementById('newName').value;
        const village = document.getElementById('newVillage').value;
        const type = document.getElementById('newType').value;

        if (!id || !name) {
            alert('الرجاء إدخال رقم المشترك واسمه بشكل صحيح.');
            return;
        }

        if (subscribers.some(s => s.id === id)) {
            alert('رقم المشترك موجود مسبقاً!');
            return;
        }

        subscribers.push({ id, name, village, type });
        localStorage.setItem('water_subscribers', JSON.stringify(subscribers));

        closeAddModal();
        document.getElementById('villageSelect').value = village;
        renderActiveTab();
        alert('تمت إضافة المشترك بنجاح في قاعدة البيانات.');
    }

    function generatePDF() {
        const month = document.getElementById('monthSelect').value;
        const year = document.getElementById('yearSelect').value;
        const village = document.getElementById('villageSelect').value;
        const titleType = (activeTab === 'readings') ? 'كشف قراءات المياه' : 'كشف التحصيل';
        
        document.getElementById('printSubTitle').innerText = `${titleType} لشهر ${month} ${year} - قرية ${village}`;
        document.getElementById('printHeader').style.display = 'block';

        const element = document.getElementById('printArea');
        const opt = {
            margin:       10,
            filename:     `${titleType}_${village}_${month}_${year}.pdf`,
            image:        { type: 'jpeg', quality: 0.98 },
            html2canvas:  { scale: 2, useCORS: true },
            jsPDF:        { unit: 'mm', format: 'a4', orientation: 'landscape' }
        };

        html2pdf().from(element).set(opt).save().then(() => {
            document.getElementById('printHeader').style.display = 'none';
        });
    }

    function exportExcel(type) {
        const village = document.getElementById('villageSelect').value;
        const month = document.getElementById('monthSelect').value;
        const year = document.getElementById('yearSelect').value;
        const key = getStorageKey(month, year);
        const filteredSubs = subscribers.filter(s => s.village === village);

        let csvContent = "\uFEFF"; // لدعم العربية في أكسفورد / إكسل
        if (type === 'readings') {
            csvContent += "م,رقم المشترك,اسم المشترك,نوع المشترك,القراءة السابقة,القراءة الحالية,الفارق,المتأخرات,الإجمالي\n";
            filteredSubs.forEach((sub, i) => {
                const rData = dbReadings[key]?.[sub.id] || { prev: 0, curr: 0, arrears: 0 };
                const diff = Math.max(0, rData.curr - rData.prev);
                const total = calculateTotal(diff, sub.type, rData.arrears);
                csvContent += `${i+1},${sub.id},"${sub.name}",${sub.type},${rData.prev},${rData.curr},${diff},${rData.arrears},${total}\n`;
            });
        } else {
            csvContent += "رقم الفاتوره,رقم المشترك,اسم المشترك,الإجمالي,المبلغ المحصل,المتبقي,الملاحظة\n";
            filteredSubs.forEach((sub, i) => {
                const rData = dbReadings[key]?.[sub.id] || { prev: 0, curr: 0, arrears: 0, collected: 0, note: "" };
                const diff = Math.max(0, rData.curr - rData.prev);
                const total = calculateTotal(diff, sub.type, rData.arrears);
                const collected = rData.collected || 0;
                const remaining = total - collected;
                const invNo = 800 + i + 1;
                csvContent += `${invNo},${sub.id},"${sub.name}",${total},${collected},${remaining},"${rData.note || ''}"\n`;
            });
        }

        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${type === 'readings' ? 'كشف_قراءات' : 'كشف_تحصيل'}_${village}_${month}_${year}.csv`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
    }
</script>
</body>
